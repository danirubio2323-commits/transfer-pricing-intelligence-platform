# Copia este fichero a `.env` y rellena los valores.
# `.env` está en .gitignore y NUNCA debe versionarse.
#
# La capa de IA es opcional: sin clave, TPIP funciona igual y el informe se
# genera completo, declarando la ausencia de la sección de IA.

# Clave de la API de Anthropic.
# Precedencia: st.secrets > variable de entorno > .env > ninguna.
ANTHROPIC_API_KEY=

# Identificador exacto del modelo. Opcional.
# Si se deja vacío, TPIP consulta el catálogo disponible en ejecución y elige
# el Sonnet más reciente. El id que acabe usándose queda registrado dentro de
# cada informe (AIExplanation.model).
ANTHROPIC_MODEL=
