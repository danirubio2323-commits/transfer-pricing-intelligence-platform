# =====================================================================
# TPIP — plantilla de configuración local.
#
# Copia este fichero a `.env` y rellena lo que necesites. El bootstrap de
# §10 ya hace esa copia si `.env` no existe.
#
# `.env` está en .gitignore y NUNCA se versiona. Este fichero sí se
# versiona, y por eso todos los valores de aquí son vacíos o ejemplos
# evidentemente falsos: es el contrato de configuración, no un secreto.
#
# NINGUNA variable es obligatoria en desarrollo. La aplicación arranca con
# este fichero entero vacío. Eso no es un descuido: es lo que permite que
# ningún paso de construcción rompa el gate de un paso anterior exigiendo
# una credencial de un servicio que todavía no se ha integrado.
#
# El único punto del proyecto que lee este fichero es
# `config/settings/base.py`, a través de pydantic-settings. Ni `manage.py`,
# ni pytest, ni los scripts lo leen por su cuenta: todos pasan por ahí.
# =====================================================================


# ---------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------

# Firma de tokens CSRF y de cualquier valor firmado.
# Necesaria a partir del PASO 26, y solo en `config.settings.production`.
# En desarrollo, `config/settings/local.py` lleva un valor explícito
# marcado como tal, así que puedes dejar esto vacío.
# Genera una así:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Modo de depuración. Nunca obligatoria: `true` por defecto en local, y
# `False` fijo en producción sin que esta variable pueda cambiarlo.
DJANGO_DEBUG=true

# Hosts admitidos, separados por comas. Necesaria a partir del PASO 26.
# La v1 se despliega en local: el servidor escucha solo en 127.0.0.1.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost


# ---------------------------------------------------------------------
# Cuenta de administrador inicial
#
# Las lee `uv run python manage.py createsuperuser --noinput`, que se
# ejecuta UNA VEZ a mano después del PASO 4, que es cuando existe la tabla
# de usuarios. No las usa el bootstrap: el bootstrap corre antes del paso
# 1 y `manage.py` todavía no existe.
#
# Sin ellas no se crea la cuenta inicial, y ningún gate falla por eso: las
# pruebas construyen sus propios usuarios.
# ---------------------------------------------------------------------

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.invalid
# Genera una así:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(18))"
DJANGO_SUPERUSER_PASSWORD=


# ---------------------------------------------------------------------
# Capa de IA — OPCIONAL de principio a fin
#
# El motor calcula; el modelo explica, fundamenta y puede sugerir, pero
# nunca decide y nunca escribe un número. Si esta sección se queda vacía,
# TPIP funciona igual: el informe se genera completo y la sección de IA
# declara su ausencia en vez de dejar un hueco.
# ---------------------------------------------------------------------

# Clave de la API de Anthropic. Consola de Anthropic -> API Keys.
# Sin ella, la capa de IA se desactiva y no se hace ni una llamada de red.
ANTHROPIC_API_KEY=

# Sin esta variable la capa de IA queda DESACTIVADA: el modelo se fija aquí y no
# se resuelve en ejecución. Un modelo que no se conoce antes de llamar tampoco se
# puede tarifar antes de llamar, y sin tarifa no hay tope de gasto comprobable.
ANTHROPIC_MODEL=claude-opus-5


# ---------------------------------------------------------------------
# Tarifas — alimentan el freno de mano del PASO 16
#
# Con estas dos vacías se registra el uso pero el coste imputado es 0: el
# sistema no inventa un precio. Con ellas puestas, `apps/ia/cuota.py`
# imputa el gasto y comprueba el tope mensual de cada cuenta ANTES de
# cualquier llamada al proveedor.
#
# Los tokens los reporta SIEMPRE el proveedor; nunca se estiman aquí.
#
# Referencia verificada el 2026-08-15 para `claude-opus-5`:
#   entrada   5 $ por millón de tokens
#   salida   25 $ por millón de tokens
#   coste por análisis: 4-5 céntimos sin caché, 1-2 con caché de prompt
# Los valores de abajo van EN EUROS y los fija quien administra, que es
# donde tiene que estar una decisión que depende del tipo de cambio.
# ---------------------------------------------------------------------

PRECIO_ENTRADA_EUR_POR_MTOK=
PRECIO_SALIDA_EUR_POR_MTOK=


# ---------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE no va aquí, a propósito.
#
# Lo fija `manage.py` para los comandos y `pyproject.toml` para pytest, y
# en los dos sitios con el mismo literal: `config.settings.local`.
# Ponerlo también aquí crearía una tercera copia del mismo valor, que es
# una más de las que se pueden contradecir.
# ---------------------------------------------------------------------
